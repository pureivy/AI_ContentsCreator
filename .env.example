# AI_ContentsCreator 환경변수 템플릿
# 실제 값은 절대 이 파일에 넣지 말 것 — 복사해서 `.env`로 저장 후 값만 채운다:
#   cp .env.example .env
# `.env`는 .gitignore 대상이라 git에 올라가지 않는다. 값은 앱 실행 중 스튜디오 UI(설정 > API 키)에서도 편집 가능.

# ── 서버 기본 ─────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1
# GEPA_DATA_DIR 미설정 시 저장소 루트를 데이터 루트로 사용
# GEPA_DATA_DIR=

# ── LLM ──────────────────────────────────────────────────
# Claude 는 구독(claude CLI) 인증으로 호출되므로 보통 불필요. CLI 미설치/PATH 문제 시에만 지정.
# CLAUDE_CLI_PATH=
# OpenAI 호환 백엔드(선택) — 이미지·TTS 등 OpenAI 기능에 필요
OPENAI_API_KEY=

# ── 블로그 스킬(Python) — 없으면 조용히 '(블로그 스킬 비활성)'로 폴백됨 ──
# 가상환경 생성: python3 -m venv scripts/blog_skills/venv && scripts/blog_skills/venv/bin/pip install -r scripts/blog_skills/requirements.txt
BLOG_PYTHON=scripts/blog_skills/venv/bin/python3
BLOG_SCRIPTS_DIR=scripts/blog_skills

# ── 네이버 발행(범용 계정 — 브랜드별 계정은 스튜디오 UI "네이버 발행 계정"에서 관리) ──
NAVER_BLOG_ID=
NAVER_LOGIN_ID=
NAVER_LOGIN_PW=
# 로그인 세션 캐시 파일 경로(미설정 시 저장소 루트의 .naver_session.json)
# NAVER_SESSION_FILE=

# ── 네이버 오픈API(검색·데이터랩 트렌드, 선택) ────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 네이버 검색광고(연관 검색량, 선택)
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=

# ── 이미지/음성(선택) ──────────────────────────────────────
FAL_KEY=
ELEVENLABS_API_KEY=
# TTS_PROVIDER=openai

# ── 알림(선택 — 미설정 시 알림 no-op) ─────────────────────
NOTIFY_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 조각별 ready(검토 대기) 알림 — 블로그·카드뉴스·쇼츠 완성 순간 push(텔레그램이면 발췌·슬라이드 앨범·영상 미리보기 동봉). 끄려면 0
# NOTIFY_CONTENT_READY=1
# 텔레그램 봇 수신 폴러 — 알림 속 발행 버튼·수정요청 답장 처리(자격 설정 시에만 실동작). 끄려면 0
# TELEGRAM_BOT=1
# 알림 속 검토 링크의 베이스 URL — 폰에서 열려면 Tailscale 주소(예: https://mac.tailnet.ts.net). 미설정 시 http://127.0.0.1:PORT
# STUDIO_BASE_URL=
# 성과 동기화 스케줄러 가동 시각(미설정 시 스케줄러 자체가 비활성됨)
# PERFORMANCE_SYNC_TIME=

# ── 유튜브 쇼츠 발행(공용 OAuth 클라이언트 1개, 채널 연결은 스튜디오 UI) ──
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# YOUTUBE_API_KEY= # 그라운딩(유튜브 데이터 조회, 선택)
# YOUTUBE_TOKENS 는 브랜드별 refresh token 저장용 — 값은 스튜디오 UI가 관리, 직접 채우지 말 것

# ── 메타(인스타그램·페이스북 페이지) 발행 ──────────────────
# 인스타그램 로그인 앱(메타 앱 > Instagram 제품 > API 설정)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# 페이스북 페이지 발행용 별도 메타 앱(메타 앱 > 설정 > 기본 설정) — 인스타 앱과 다름
META_APP_ID=
META_APP_SECRET=
# 비즈니스용 Facebook 로그인 구성 ID(대시보드에서 생성)
# META_FB_CONFIG_ID=
# OAuth 콜백 전용 HTTPS 리스너 포트(미설정 시 PORT+1)
# META_HTTPS_PORT=
# META_TOKENS 는 브랜드별 페이지·IG 토큰 저장용 — 값은 스튜디오 UI가 관리, 직접 채우지 말 것

# ── 그라운딩 커넥터(선택) ──────────────────────────────────
LAW_API_KEY=
DART_API_KEY=

# ── 접근 제어(선택) ────────────────────────────────────────
# Tailscale 등 외부 접근 허용 호스트(쉼표 구분)
# ALLOWED_HOSTS=
# 설정 시 API 요청에 Bearer 인증 필요(기본은 게이트 없음)
# AUTH_TOKEN=
